<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:LidarViewer.App.ViewModels"
        xmlns:c="using:LidarViewer.App.Controls"
        xmlns:conv="using:LidarViewer.App.Converters"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="600"
        x:Class="LidarViewer.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Width="1400" Height="880"
        WindowStartupLocation="CenterScreen"
        Title="LidarViewer">

    <Window.Resources>
        <conv:FloatTextConverter x:Key="FloatText" />
        <conv:NumberTextConverter x:Key="NumberText" />
        <conv:FilterKindToBoolConverter x:Key="KindToBool" />
        <conv:LiveProtocolToTextConverter x:Key="ProtocolToText" />
    </Window.Resources>

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <Grid RowDefinitions="Auto,*,Auto">
        <StackPanel Grid.Row="0" x:Name="Toolbar" Margin="6,6,6,2" Spacing="2">
            <WrapPanel>
                <TextBox Text="{Binding FilePath}" Width="320" Margin="0,0,6,4"
                         PlaceholderText="Ścieżka do pliku (.vtp, .vtk, .csv, .xyz, .ply, .pcd, .las)" />
                <Button Content="Wybierz plik..." Click="OnBrowseClick" Margin="0,0,6,4" />
                <Button Content="Sekwencja..." Click="OnBrowseSequenceClick" Margin="0,0,6,4" />
                <Button Content="Wyświetl" Command="{Binding LoadCommand}" Margin="0,0,6,4" />
                <Button Content="Zapisz jako..." x:Name="SaveAsButton" Click="OnSaveAsClick" Margin="0,0,6,4" />
                <ComboBox ItemsSource="{Binding ViewModes}" SelectedItem="{Binding ViewMode}"
                          Width="110" Margin="0,0,6,4" VerticalAlignment="Center" />
                <ComboBox ItemsSource="{Binding Planes}" SelectedItem="{Binding Plane}" Width="90"
                          Margin="0,0,6,4" VerticalAlignment="Center" IsVisible="{Binding Is2D}" />
            </WrapPanel>

            <WrapPanel>
                <TextBlock Text="Kolor:" VerticalAlignment="Center" Margin="0,0,6,4" />
                <ComboBox ItemsSource="{Binding ColorModes}" SelectedItem="{Binding ColorMode}"
                          Width="120" Margin="0,0,6,4" />
                <TextBlock Text="Mapa:" VerticalAlignment="Center" Margin="0,0,6,4"
                           IsVisible="{Binding ShowLegend}" />
                <ComboBox ItemsSource="{Binding Colormaps}" SelectedItem="{Binding Colormap}" Width="120"
                          Margin="0,0,6,4" IsVisible="{Binding ShowLegend}" />
                <CheckBox Content="Auto zakres" IsChecked="{Binding AutoColorRange}" VerticalAlignment="Center"
                          Margin="0,0,6,4" IsVisible="{Binding ShowLegend}" />
                <TextBlock Text="min / max" VerticalAlignment="Center" Margin="0,0,6,4"
                           IsVisible="{Binding ShowLegend}" />
                <TextBox Width="80" Margin="0,0,6,4" IsVisible="{Binding ShowLegend}"
                         Text="{Binding ColorRangeMin, Converter={StaticResource FloatText}, UpdateSourceTrigger=LostFocus}" />
                <TextBox Width="80" Margin="0,0,6,4" IsVisible="{Binding ShowLegend}"
                         Text="{Binding ColorRangeMax, Converter={StaticResource FloatText}, UpdateSourceTrigger=LostFocus}" />
                <TextBlock Text="{Binding ColorWarning}" Foreground="#FFE08A" VerticalAlignment="Center"
                           Margin="0,0,6,4" />
            </WrapPanel>

            <WrapPanel x:Name="LiveRow">
                <TextBlock Text="Live UDP:" VerticalAlignment="Center" Margin="0,0,6,4" />
                <TextBox Text="{Binding LivePort}" Width="80" Margin="0,0,6,4" VerticalAlignment="Center" />
                <ComboBox ItemsSource="{Binding LiveProtocols}" SelectedItem="{Binding LiveProtocol}"
                          Width="150" Margin="0,0,6,4" VerticalAlignment="Center">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:LiveProtocol">
                            <TextBlock Text="{Binding Converter={StaticResource ProtocolToText}}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <Button Content="Start" Command="{Binding StartLiveCommand}" Margin="0,0,6,4"
                        VerticalAlignment="Center" IsEnabled="{Binding !IsLive}" />
                <Button Content="Stop" Command="{Binding StopLiveCommand}" Margin="0,0,6,4"
                        VerticalAlignment="Center" IsVisible="{Binding IsLive}" />
                <Button Content="Nagrywaj" x:Name="RecordButton" Click="OnRecordClick" Margin="0,0,6,4"
                        VerticalAlignment="Center" IsVisible="{Binding CanStartRecording}" />
                <Button Content="Stop nagrania" x:Name="StopRecordButton" Click="OnStopRecordingClick" Margin="0,0,6,4"
                        VerticalAlignment="Center" IsVisible="{Binding IsRecording}" />
                <TextBlock Text="{Binding RecordInfo}" VerticalAlignment="Center" Margin="0,0,6,4"
                           IsVisible="{Binding IsRecording}" />
                <CheckBox Content="Symulator" IsChecked="{Binding SimulatorEnabled}" VerticalAlignment="Center"
                          Margin="0,0,6,4" />
            </WrapPanel>
        </StackPanel>

        <Grid Grid.Row="1" ColumnDefinitions="*,Auto">
            <DockPanel Grid.Column="0">
                <TextBox DockPanel.Dock="Bottom" Text="{Binding Diagnostics, Mode=OneWay}" IsReadOnly="True"
                         AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="140" Margin="6,0,6,6"
                         IsVisible="{Binding IsDiagnosticsOpen}" />
                <Border DockPanel.Dock="Bottom" Padding="8,6" Background="#14FFFFFF"
                        IsVisible="{Binding HasSequence}">
                    <StackPanel Spacing="6">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="Odtwórz" Command="{Binding PlayPauseCommand}" />
                            <Slider x:Name="SeekSlider" Width="320" Minimum="0" Maximum="{Binding Duration}"
                                    Value="{Binding PositionSeconds}" />
                            <TextBlock Text="{Binding FrameInfo}" VerticalAlignment="Center" MinWidth="90" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="Tempo" VerticalAlignment="Center" />
                            <ComboBox Width="90" ItemsSource="{Binding Speeds}" SelectedItem="{Binding Speed}"
                                      DisplayMemberBinding="{Binding Label}" />
                            <CheckBox Content="Pętla" IsChecked="{Binding Loop}" VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Grid>
                    <c:PointCloudView3D x:Name="View3D" IsVisible="{Binding Is3D}" PointCloud="{Binding PointCloud}"
                                        ColorSettings="{Binding ColorSettings}"
                                        AutoFitCamera="{Binding AutoFitCamera}"
                                        FitVersion="{Binding FitVersion}"
                                        SensorView="{Binding IsSensorView}"
                                        Diagnostics="{Binding Diagnostics, Mode=OneWayToSource}" />
                    <c:PointCloudView x:Name="View2D" IsVisible="{Binding Is2D}" PointCloud="{Binding PointCloud}"
                                      Plane="{Binding Plane}" ColorSettings="{Binding ColorSettings}"
                                      AutoResetView="{Binding AutoResetView}" />
                    <Border HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="12" Padding="8"
                            Background="#D91A1A1A" CornerRadius="4" IsVisible="{Binding ShowLegend}">
                        <c:ColorLegend ColorSettings="{Binding ColorSettings}" Title="{Binding LegendTitle}" />
                    </Border>
                </Grid>
            </DockPanel>

            <ScrollViewer Grid.Column="1" x:Name="FiltersPanel" Width="320" Background="#F2202020"
                          BorderBrush="#40FFFFFF" BorderThickness="1,0,0,0"
                          IsVisible="{Binding IsFiltersPanelOpen}">
                <StackPanel Margin="12" Spacing="8">
                    <TextBlock Text="Filtry" FontSize="16" FontWeight="Bold" />
                    <TextBlock Text="Filtry nie działają w trybie live." Foreground="#FFE08A" FontSize="11"
                               IsVisible="{Binding IsLive}" TextWrapping="Wrap" />

                    <StackPanel IsEnabled="{Binding !IsLive}" Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <ComboBox ItemsSource="{Binding Pipeline.AvailableFilters}"
                                      SelectedItem="{Binding Pipeline.SelectedAvailableFilter}"
                                      DisplayMemberBinding="{Binding Name}" Width="200" />
                            <Button Content="Dodaj" Command="{Binding Pipeline.AddStage}"
                                    CommandParameter="{Binding Pipeline.SelectedAvailableFilter.Id}" />
                        </StackPanel>

                        <ListBox ItemsSource="{Binding Pipeline.Stages}" SelectedItem="{Binding Pipeline.SelectedStage}"
                                 MaxHeight="240">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:PipelineStageViewModel">
                                    <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,4">
                                        <CheckBox Grid.Column="0" IsChecked="{Binding Enabled}" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Name}" />
                                            <TextBlock FontSize="11" Opacity="0.7">
                                                <TextBlock.Text>
                                                    <MultiBinding StringFormat="{}{0:N0} → {1:N0} pkt">
                                                        <Binding Path="InputCount" />
                                                        <Binding Path="OutputCount" />
                                                    </MultiBinding>
                                                </TextBlock.Text>
                                            </TextBlock>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Content="▲" Margin="2,0"
                                                    Command="{Binding $parent[ListBox].DataContext.Pipeline.MoveStageUp}"
                                                    CommandParameter="{Binding Index}" />
                                            <Button Content="▼" Margin="2,0"
                                                    Command="{Binding $parent[ListBox].DataContext.Pipeline.MoveStageDown}"
                                                    CommandParameter="{Binding Index}" />
                                            <Button Content="✕" Margin="2,0"
                                                    Command="{Binding $parent[ListBox].DataContext.Pipeline.RemoveStage}"
                                                    CommandParameter="{Binding Index}" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <StackPanel IsVisible="{Binding Pipeline.HasEditor}" Spacing="6">
                            <TextBlock Text="{Binding Pipeline.Editor.Title}" FontWeight="Bold" />
                            <ItemsControl ItemsSource="{Binding Pipeline.Editor.Parameters}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:FilterParameterViewModel">
                                        <StackPanel Spacing="2" Margin="0,4">
                                            <TextBlock Text="{Binding Label}" FontSize="11" />
                                            <TextBox Text="{Binding Number, Converter={StaticResource NumberText}, UpdateSourceTrigger=LostFocus}"
                                                     IsVisible="{Binding Kind, Converter={StaticResource KindToBool}, ConverterParameter=Number}" />
                                            <ComboBox ItemsSource="{Binding Choices}" SelectedIndex="{Binding SelectedChoice}"
                                                      IsVisible="{Binding Kind, Converter={StaticResource KindToBool}, ConverterParameter=Choice}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Button Content="Zastosuj" Command="{Binding Pipeline.Editor.Apply}" />
                                <Button Content="Anuluj" Command="{Binding Pipeline.Editor.Cancel}" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <Border Grid.Row="2" Padding="8,4" Background="#F2202020" BorderBrush="#40FFFFFF" BorderThickness="0,1,0,0">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0" Text="{Binding Status}" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="{Binding LiveInfo}" VerticalAlignment="Center" />
                    <Button Content="Resetuj widok" Click="OnResetViewClick" ToolTip.Tip="Skrót: R" />
                    <ToggleButton Content="Filtry" IsChecked="{Binding IsFiltersPanelOpen}" />
                    <ToggleButton Content="Log" IsChecked="{Binding IsDiagnosticsOpen}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>

</Window>
