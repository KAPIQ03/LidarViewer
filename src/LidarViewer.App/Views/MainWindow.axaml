<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:LidarViewer.App.ViewModels"
        xmlns:views="using:LidarViewer.App.Views"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1360" d:DesignHeight="850"
        x:Class="LidarViewer.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="LidarViewer"
        Width="1360" Height="850" MinWidth="1080" MinHeight="680"
        Background="#0B1017" Foreground="#E8EDF2">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <Window.Styles>
        <Style Selector="TextBlock.section-title">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#9AAABD" />
            <Setter Property="LetterSpacing" Value="1.2" />
        </Style>
        <Style Selector="Button">
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBox">
            <Setter Property="MinHeight" Value="36" />
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="68,*" ColumnDefinitions="300,*">
        <Border Grid.Row="0" Grid.ColumnSpan="2"
                Background="#101720" BorderBrush="#202B38" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="*,Auto" Margin="24,0">
                <StackPanel VerticalAlignment="Center" Spacing="3">
                    <TextBlock Text="LIDAR VIEWER" FontSize="18" FontWeight="Bold" LetterSpacing="2" />
                    <TextBlock Text="Punktowa analiza przestrzenna" Foreground="#8797AA" FontSize="11" />
                </StackPanel>
                <Border Grid.Column="1" Background="#19242F" CornerRadius="14" Padding="12,7"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="{Binding ModeText}" FontSize="11" FontWeight="SemiBold" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Border Grid.Row="1" Grid.Column="0" Background="#101720"
                BorderBrush="#202B38" BorderThickness="0,0,1,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="18" Spacing="16">
                    <TextBlock Classes="section-title" Text="ŹRÓDŁO DANYCH" />
                    <Border Background="#151F2A" BorderBrush="#253342" BorderThickness="1" CornerRadius="8" Padding="12">
                        <StackPanel Spacing="10">
                            <TextBlock Text="{Binding FileName}" TextTrimming="CharacterEllipsis"
                                       ToolTip.Tip="{Binding FileName}" FontSize="12" />
                            <Button Content="Otwórz plik .VTP / .CSV" Click="OpenFile_Click" />
                        </StackPanel>
                    </Border>

                    <TextBlock Classes="section-title" Text="URZĄDZENIE · UDP" />
                    <Border Background="#151F2A" BorderBrush="#253342" BorderThickness="1" CornerRadius="8" Padding="12">
                        <StackPanel Spacing="10">
                            <TextBlock Text="Port nasłuchu" Foreground="#9AAABD" FontSize="11" />
                            <TextBox Text="{Binding UdpPort}" PlaceholderText="np. 2368" />
                            <Button Content="▶  Rozpocznij odbiór" Command="{Binding StartListeningCommand}" />
                            <Button Content="■  Zatrzymaj odbiór" Command="{Binding StopListeningCommand}" />
                            <TextBlock Text="JSON: { &quot;points&quot;: [[x,y,z,intensity], …] }"
                                       Foreground="#718196" FontSize="10" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <TextBlock Classes="section-title" Text="NAGRYWANIE" />
                    <Border Background="#151F2A" BorderBrush="#253342" BorderThickness="1" CornerRadius="8" Padding="12">
                        <StackPanel Spacing="10">
                            <TextBlock Text="{Binding RecordingPath}" TextTrimming="CharacterEllipsis"
                                       Foreground="#9AAABD" FontSize="10" />
                            <Button Content="●  Rozpocznij nagrywanie" Click="StartRecording_Click" />
                            <Button Content="Zatrzymaj i zamknij plik" Command="{Binding StopRecordingCommand}" />
                        </StackPanel>
                    </Border>

                    <TextBlock Classes="section-title" Text="PODSUMOWANIE" />
                    <Border Background="#151F2A" BorderBrush="#253342" BorderThickness="1" CornerRadius="8" Padding="12">
                        <StackPanel Spacing="12">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="Punkty" Foreground="#9AAABD" FontSize="11" />
                                <TextBlock Grid.Column="1" Text="{Binding PointCountText}" FontWeight="SemiBold" />
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="Śr. intensywność" Foreground="#9AAABD" FontSize="11" />
                                <TextBlock Grid.Column="1" Text="{Binding AverageIntensityText}" FontWeight="SemiBold" />
                            </Grid>
                            <TextBlock Text="Zakres XYZ" Foreground="#9AAABD" FontSize="11" />
                            <TextBlock Text="{Binding RangeText}" FontSize="10" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Grid Grid.Row="1" Grid.Column="1" RowDefinitions="56,*,62" Margin="18">
            <Grid ColumnDefinitions="*,Auto" Margin="4,0">
                <StackPanel VerticalAlignment="Center" Spacing="3">
                    <TextBlock Text="PODGLĄD CHMURY PUNKTÓW" FontSize="12" FontWeight="SemiBold" LetterSpacing="1" />
                    <TextBlock Text="LPM: obrót   ·   Shift + przeciągnij / PPM: przesunięcie   ·   kółko: zoom"
                               Foreground="#8494A7" FontSize="10" />
                </StackPanel>
                <Button Grid.Column="1" Content="Reset kamery" Click="ResetCamera_Click"
                        VerticalAlignment="Center" MinHeight="32" />
            </Grid>

            <Border Grid.Row="1" Background="#0B1119" BorderBrush="#263342"
                    BorderThickness="1" CornerRadius="8" ClipToBounds="True">
                <views:PointCloudView x:Name="CloudView" Points="{Binding Points}" />
            </Border>

            <Border Grid.Row="2" Background="#111A24" BorderBrush="#263342"
                    BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,12,0,0">
                <Grid ColumnDefinitions="Auto,*">
                    <Ellipse Width="7" Height="7" Fill="#47D7C2" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <TextBlock Grid.Column="1" Text="{Binding StatusText}" Foreground="#B6C2D0"
                               VerticalAlignment="Center" TextWrapping="Wrap" FontSize="11" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
