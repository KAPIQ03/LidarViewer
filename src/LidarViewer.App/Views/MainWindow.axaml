<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:LidarViewer.App.ViewModels"
        xmlns:c="using:LidarViewer.App.Controls"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="LidarViewer.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="LidarViewer">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <!-- Układ: u góry pole na ścieżkę + przycisk, na dole pasek stanu, środek = widok 3D. -->
    <DockPanel>
        <DockPanel DockPanel.Dock="Top">
            <Button DockPanel.Dock="Right" Content="Wyświetl" Command="{Binding LoadCommand}" />
            <ComboBox DockPanel.Dock="Right" ItemsSource="{Binding ViewModes}" SelectedItem="{Binding ViewMode}" />
            <!-- Płaszczyzna rzutu ma sens tylko w widoku 2D. -->
            <ComboBox DockPanel.Dock="Right" ItemsSource="{Binding Planes}" SelectedItem="{Binding Plane}"
                      IsVisible="{Binding Is2D}" />
            <Button DockPanel.Dock="Right" Content="Wybierz plik..." Click="OnBrowseClick" />
            <TextBox Text="{Binding FilePath}" PlaceholderText="Ścieżka do pliku (.vtp, .vtk, .csv, .ply, .pcd, .las)" />
        </DockPanel>
        <TextBlock DockPanel.Dock="Bottom" Text="{Binding Status}" />
        <!-- Dziennik diagnostyczny OpenGL (do skopiowania): wersja GL, błędy shaderów i GL. -->
        <TextBox DockPanel.Dock="Bottom" Text="{Binding Diagnostics, Mode=OneWay}" IsReadOnly="True"
                 AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="120" />
        <!-- Oba widoki w jednym polu; widoczny jest tylko wybrany. -->
        <Grid>
            <c:PointCloudView3D IsVisible="{Binding Is3D}" PointCloud="{Binding PointCloud}"
                                Diagnostics="{Binding Diagnostics, Mode=OneWayToSource}" />
            <c:PointCloudView IsVisible="{Binding Is2D}" PointCloud="{Binding PointCloud}" Plane="{Binding Plane}" />
        </Grid>
    </DockPanel>

</Window>
